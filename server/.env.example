# ============================================
# CertiGen Server - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/certigen?retryWrites=true&w=majority

# For local: mongodb://localhost:27017/certigen

# Redis (for BullMQ job queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# GridFS bucket (MongoDB file storage)
GRIDFS_BUCKET=files

# JWT Authentication
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP - works with Gmail, Mailjet, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=CertiGen
EMAIL_FROM_ADDRESS=noreply@certigen.com

# File Upload Limits
MAX_FILE_SIZE_MB=10
MAX_TEMPLATE_SIZE_MB=25

# Business/Storage Limits
MAX_TEMPLATES_PER_ADMIN=5
MAX_MONGO_STORAGE_MB=200

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
