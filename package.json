{
  "name": "certificate-generator",
  "version": "1.0.0",
  "description": "A simple and powerful web app to generate and download personalized certificates for multiple users using HTML Canvas and JavaScript.",
  "keywords": [],
  "homepage": "https://github.com/jayramgit94/Certificate_generator#readme",
  "bugs": {
    "url": "https://github.com/jayramgit94/Certificate_generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayramgit94/Certificate_generator.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "seed": "cd server && node src/scripts/seed.js",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "googleapis": "^148.0.0",
    "jspdf": "^3.0.1",
    "multer": "^1.4.5-lts.2",
    "node-mailjet": "^6.0.8",
    "nodemailer": "^6.10.1",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "pdfjs-dist": "^5.1.91"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
